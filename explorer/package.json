{
  "name": "reqvire-explorer",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "description": "Native static SPA Explorer shell for the Reqvire Project Store (Task-49 scaffold).",
  "scripts": {
    "dev": "npm run generate:icons && vite",
    "check": "npm run lint && npm run typecheck",
    "build": "npm run lint:style && npm run typecheck && npm run build:app",
    "build:app": "npm run generate:icons && vite build",
    "build:all": "npm run build && npm run build:ds-bundle",
    "build:ds-bundle": "vite build --config design-system/vite.bundle.config.ts",
    "ads-mcp": "npx --yes @reqvire-org/ads@0.3.0 mcp --mutations",
    "ads-read-mcp": "npx --yes @reqvire-org/ads@0.3.0 mcp",
    "dev:showcase": "npx --yes @reqvire-org/ads@0.3.0 showcase",
    "build:showcase": "npm run build:mcp-previews",
    "generate:icons": "node scripts/generate-icons.mjs",
    "generate:coverage-showcase": "python3 scripts/generate-coverage-showcase.py",
    "lint": "npm run lint:ds && npm run lint:style",
    "lint:style": "biome lint --config-path=biome.css.json .",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && npm run test:toast",
    "test:toast": "node scripts/test-toast.mjs && node scripts/test-toast-usage.mjs",
    "lint:ds": "ads lint-config . && ads check . && oxlint --deny-warnings --config .ds/oxlintrc.json 'src' 'design-system'",
    "assets:ds": "ads assets",
    "prebuild": "npm run lint:ds && npm run assets:ds",
    "prebuild:showcase": "npm run lint:ds && npm run assets:ds",
    "build:mcp-previews": "node scripts/build-mcp-previews.mjs"
  },
  "dependencies": {
    "@linaria/atomic": "^8.0.0",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@noble/hashes": "^2.4.0",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-image": "^3.0.0",
    "@types/d3": "^7.4.3",
    "@wyw-in-js/babel-preset": "^2.0.1",
    "@xyflow/react": "^12.10.0",
    "d3": "^7.9.0",
    "elkjs": "0.9.3",
    "graphology": "^0.25.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "preact": "11.0.1",
    "react": "npm:@preact/compat@18.3.2",
    "react-dom": "npm:@preact/compat@18.3.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "sigma": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "2.5.15",
    "@reqvire-org/ads": "0.3.0",
    "@testing-library/preact": "3.2.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wyw-in-js/vite": "^2.0.1",
    "jsdom": "^25.0.1",
    "oxlint": "^1.69.0",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  }
}
