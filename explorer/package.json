{
  "name": "reqvire-explorer",
  "version": "0.1.0",
  "private": true,
  "sideEffects": [
    "**/*.css"
  ],
  "type": "module",
  "description": "Native static SPA Explorer shell for the Reqvire Project Store (Task-49 scaffold).",
  "scripts": {
    "dev": "bun run generate:icons && bun scripts/run-node.mjs --max-old-space-size=1600 node_modules/vite/bin/vite.js",
    "check": "bun run lint && bun run typecheck",
    "build": "bun run lint:style && bun run typecheck && bun run test && bun run build:app",
    "build:app": "bun run generate:icons && bun scripts/run-node.mjs --max-old-space-size=1600 node_modules/vite/bin/vite.js build",
    "build:all": "bun run build && bun run build:ds-bundle",
    "build:ds-bundle": "bun scripts/run-node.mjs --max-old-space-size=1600 node_modules/vite/bin/vite.js build --config design-system/vite.bundle.config.ts",
    "ads-mcp": "bun node_modules/@reqvire-org/ads/dist/cli.mjs mcp --mutations",
    "ads-read-mcp": "bun node_modules/@reqvire-org/ads/dist/cli.mjs mcp",
    "dev:showcase": "bun node_modules/@reqvire-org/ads/dist/cli.mjs showcase",
    "build:showcase": "bun run build:mcp-previews",
    "generate:icons": "bun scripts/generate-icons.mjs",
    "generate:coverage-showcase": "bash scripts/generate-coverage-showcase.sh",
    "lint": "bun run lint:ds && bun run lint:style",
    "lint:style": "biome lint --config-path=biome.css.json .",
    "preview": "bun scripts/run-node.mjs node_modules/vite/bin/vite.js preview",
    "typecheck": "bun node_modules/typescript/bin/tsc --noEmit",
    "test": "bun scripts/run-node.mjs --max-old-space-size=1200 node_modules/vitest/vitest.mjs run",
    "test:ads": "bun run build:mcp-previews && ads verify .",
    "test:behavior": "bun node_modules/@playwright/test/cli.js test --config playwright.ads.config.ts",
    "lint:ds": "ads check .",
    "assets:ds": "ads assets",
    "prebuild": "bun run lint:ds && bun run assets:ds",
    "prebuild:showcase": "bun run lint:ds && bun run assets:ds",
    "build:mcp-previews": "bun scripts/build-mcp-previews.mjs",
    "prebuild:mcp-previews": "bun run generate:icons"
  },
  "dependencies": {
    "@linaria/atomic": "^8.0.0",
    "@linaria/core": "^7.0.0",
    "@linaria/react": "^7.0.1",
    "@noble/hashes": "^2.4.0",
    "@sigma/edge-curve": "^3.1.0",
    "@sigma/node-image": "^3.0.0",
    "@types/d3": "^7.4.3",
    "@wyw-in-js/babel-preset": "^2.0.1",
    "@xyflow/react": "^12.10.0",
    "d3": "^7.9.0",
    "elkjs": "0.9.3",
    "graphology": "^0.25.4",
    "graphology-layout-forceatlas2": "^0.10.1",
    "graphology-layout-noverlap": "^0.4.2",
    "mermaid": "^12.2.0",
    "minisearch": "^7.2.0",
    "preact": "11.0.1",
    "react": "npm:@preact/compat@18.3.2",
    "react-dom": "npm:@preact/compat@18.3.2",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "shiki": "^4.2.0",
    "sigma": "^3.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@biomejs/biome": "2.5.15",
    "@playwright/test": "1.64.1",
    "@reqvire-org/ads": "0.3.46",
    "@testing-library/preact": "3.2.4",
    "@types/node": "^25.9.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@wyw-in-js/vite": "^2.0.1",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.28",
    "sharp": "^0.35.4",
    "typescript": "^5.6.3",
    "vite": "^6.0.7",
    "vitest": "^4.1.11"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.1",
    "node": ">=24"
  }
}
