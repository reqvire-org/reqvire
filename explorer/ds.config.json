{
  "schemaVersion": 1,
  "resources": {
    "memoryLimitMb": 6144
  },
  "sourceDir": "src",
  "dsDir": "design-system",
  "themes": [
    {
      "name": "light",
      "scheme": "light"
    },
    {
      "name": "dark",
      "scheme": "dark"
    }
  ],
  "followSystemTheme": true,
  "assets": {
    "publicDirs": [
      "public/assets"
    ],
    "generatedPaths": [
      "dist",
      "dist-kit",
      "design-system/dist-showcase",
      ".vite",
      ".ds",
      "_ds_bundle.js",
      "design-system/_ds_bundle.js",
      "design-system/reqvire-explorer.css",
      "design-system/_ds_manifest.json",
      "design-system/_adherence.oxlintrc.json"
    ],
    "generatedFiles": [
      "project-store.js",
      "android-chrome-192x192.png",
      "apple-touch-icon.png",
      "browserconfig.xml",
      "favicon-16x16.png",
      "favicon-32x32.png",
      "favicon.ico",
      "icon-192.png",
      "icon-512.png",
      "logo.png",
      "mstile-150x150.png",
      "site.webmanifest"
    ]
  },
  "layout": {
    "widthTokens": [
      "--color-role-thesaurus-map-concept-node-min-width",
      "--color-role-thesaurus-map-scheme-node-min-width",
      "--side-pane-width",
      "--space-flow-node-width",
      "--space-markdown-diagram-measure"
    ]
  },
  "framework": "preact@11.0.1",
  "mcp": {
    "showcaseTitle": "Reqvire Design System",
    "capture": {
      "channel": "chrome"
    },
    "behaviorProfiles": {
      "widget": {
        "runner": "playwright",
        "command": "bun",
        "args": [
          "run",
          "test:behavior",
          "--"
        ],
        "mode": "browser",
        "timeoutMs": 240000
      }
    }
  },
  "behaviorLibraries": [
    "@sigma/edge-curve@3.1.0",
    "@sigma/node-image@3.0.0",
    "@xyflow/react@12.12.0",
    "elkjs@0.9.3",
    "graphology@0.25.4",
    "graphology-layout-forceatlas2@0.10.1",
    "graphology-layout-noverlap@0.4.2",
    "sigma@3.0.3"
  ],
  "usage": {
    "notifications": [
      {
        "api": "toast",
        "host": "Toaster",
        "rootFiles": [
          "src/App.tsx",
          "design-system/components/core/Toast.ads.scenario.tsx"
        ]
      }
    ],
    "restrictedImports": [
      "sonner"
    ]
  },
  "acceptance": {
    "scripts": [
      "lint:style",
      "typecheck"
    ],
    "behavior": true,
    "audit": true
  },
  "validation": {
    "scripts": [
      "test",
      "build:app"
    ],
    "inputs": []
  }
}
