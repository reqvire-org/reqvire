<https://www.reqvire.org/ontology> <http://www.w3.org/2000/01/rdf-schema#label> "Reqvire ontology" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Canonical ontology document for same-base Reqvire ontology elements; derived ontology elements contribute vocabulary to this document." .
<https://www.reqvire.org/ontology#Element> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Base class for addressable Reqvire model elements and related model artifacts." .
<https://www.reqvire.org/ontology#Capability> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Coherent operational, product, business, regulatory, or system ability that bridges ontology, requirements, and verification." .
<https://www.reqvire.org/ontology#Requirement> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Implementation-facing obligation that can be verified and satisfied by implementation or evidence." .
<https://www.reqvire.org/ontology#Contract> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Requirement-owned detail element that defines a requirement with source, behavioral, structural, query, or contract information." .
<https://www.reqvire.org/ontology#ConceptScheme> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Markdown-native Reqvire element that authors a SKOS concept scheme or thesaurus boundary." .
<https://www.reqvire.org/ontology#Concept> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Markdown-native Reqvire element that authors one curated SKOS concept." .
<https://www.reqvire.org/ontology#Verification> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Evidence or method used to verify a requirement." .
<https://www.reqvire.org/ontology#Artifact> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Referenced implementation, evidence, document, or external resource artifact." .
<https://www.reqvire.org/ontology#RuntimeOntologyArtifact> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Artifact> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Generated runtime ontology snapshot embedded by Reqvire core and derived from authored ontology source." .
<https://www.reqvire.org/ontology#RuntimeOntologyNamespace> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Term namespace selected as the Reqvire runtime vocabulary boundary for generated runtime ontology artifacts." .
<https://www.reqvire.org/ontology#NamespaceScopedOntologyExport> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Clean authored semantic export filtered to one ontology base or term namespace." .
<https://www.reqvire.org/ontology#OntologySourceOfTruth> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Authored ontology source model that governs generated runtime ontology artifacts." .
<https://www.reqvire.org/ontology#OntologyDocument> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Generated or authored ontology document identified by ontology base IRI and containing contributed ontology terms." .
<https://www.reqvire.org/ontology#File> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Artifact> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Repository-internal file artifact referenced by Reqvire relations, reused_contract_context, or evidence links." .
<https://www.reqvire.org/ontology#CustomElement> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Custom model extension element whose authored metadata type follows other-TYPENAME and cannot author canonical semantic relations." .
<https://www.reqvire.org/ontology#ElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Canonical metadata type value used to classify Reqvire elements." .
<https://www.reqvire.org/ontology#CapabilityElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementType> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Element type category for capability elements." .
<https://www.reqvire.org/ontology#RequirementElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementType> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Element type category for requirement obligations." .
<https://www.reqvire.org/ontology#ContractElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementType> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Element type category for requirement-owned contracts." .
<https://www.reqvire.org/ontology#ConceptElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementType> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Element type category for Markdown-native SKOS concept schemes and concepts." .
<https://www.reqvire.org/ontology#SemanticContractElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementType> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Element type category for reusable semantic-contract SHACL profile elements." .
<https://www.reqvire.org/ontology#VerificationElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementType> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Element type category for verification methods and evidence records." .
<https://www.reqvire.org/ontology#CustomElementType> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementType> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Element type category for custom other-TYPENAME extensions that cannot author canonical semantic relations." .
<https://www.reqvire.org/ontology#ElementIdentity> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Stable identity concept used to track an element independently of its current file location." .
<https://www.reqvire.org/ontology#ElementId> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementIdentity> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Stable identifier derived from element name and used for identity tracking across relocations." .
<https://www.reqvire.org/ontology#ElementIdentifier> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ElementIdentity> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Location-based address that combines file path and fragment for authored references." .
<https://www.reqvire.org/ontology#ElementLocation> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "File and section location context for an element, separate from stable identity." .
<https://www.reqvire.org/ontology#ReferenceTargetKind> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Stable semantic category for relation or reused_contract_context target resolution." .
<https://www.reqvire.org/ontology#ElementIdentifierTarget> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ReferenceTargetKind> ;
