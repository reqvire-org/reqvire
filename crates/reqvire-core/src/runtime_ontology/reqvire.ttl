	<http://www.w3.org/2000/01/rdf-schema#domain> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2000/01/rdf-schema#range> <https://www.reqvire.org/ontology#Element> ;
	<http://www.w3.org/2002/07/owl#inverseOf> <https://www.reqvire.org/ontology#parentElement> ;
