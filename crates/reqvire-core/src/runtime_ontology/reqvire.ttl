	<http://www.w3.org/2002/07/owl#someValuesFrom> <https://www.reqvire.org/ontology#Artifact> .
<https://www.reqvire.org/ontology#EvidenceBackedVerification> <http://www.w3.org/2000/01/rdf-schema#subClassOf> _:b82d87aa9e23b401e4c3857028bedcc6 ;
	<http://www.w3.org/2002/07/owl#disjointWith> <https://www.reqvire.org/ontology#NonEvidenceBackedVerification> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Verification class whose instances require satisfiedBy evidence for coverage satisfaction." .
<https://www.reqvire.org/ontology#NonEvidenceBackedVerification> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Non-evidence-backed verification" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ConcreteVerification> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Verification class whose instances do not require satisfiedBy evidence for coverage satisfaction." .
