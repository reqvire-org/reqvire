	<https://www.reqvire.org/ontology#validationRuleName> "global-element-name-uniqueness" ;
	<https://www.reqvire.org/ontology#validationScope> "model" ;
	<https://www.reqvire.org/ontology#validationSeverity> "error" ;
	<https://www.reqvire.org/ontology#validationCondition> "Two parsed elements have the same element name." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Validation fails because element names are stable global identity keys." ;
	<https://www.reqvire.org/ontology#validationRepair> "Rename one element and update incoming references." .
