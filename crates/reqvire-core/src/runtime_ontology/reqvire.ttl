<https://www.reqvire.org/ontology#lowPriority> a <https://www.reqvire.org/ontology#PriorityValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "low" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Useful or desirable, but deferrable without major mission, stakeholder, or integration impact." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> false .
<https://www.reqvire.org/ontology#mediumPriority> a <https://www.reqvire.org/ontology#PriorityValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "medium" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Normal planning importance; expected to be delivered unless schedule, cost, or scope tradeoffs require adjustment." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> true .
<https://www.reqvire.org/ontology#highPriority> a <https://www.reqvire.org/ontology#PriorityValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "high" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Important to mission, stakeholder value, integration, or compliance and should be protected during tradeoffs." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> false .
<https://www.reqvire.org/ontology#criticalPriority> a <https://www.reqvire.org/ontology#PriorityValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "critical" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Essential; failure to satisfy creates unacceptable mission, safety, compliance, contractual, or release impact." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> false .
<https://www.reqvire.org/ontology#lowRisk> a <https://www.reqvire.org/ontology#RiskValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "low" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Requirement realization is well understood, stable, feasible, and straightforward to verify." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> true .
<https://www.reqvire.org/ontology#mediumRisk> a <https://www.reqvire.org/ontology#RiskValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "medium" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Requirement realization has manageable uncertainty, moderate implementation or verification complexity, or limited downstream coupling." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> false .
<https://www.reqvire.org/ontology#highRisk> a <https://www.reqvire.org/ontology#RiskValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "high" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Requirement realization has significant technical uncertainty, volatility, verification difficulty, integration exposure, or likely downstream rework." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> false .
<https://www.reqvire.org/ontology#criticalRisk> a <https://www.reqvire.org/ontology#RiskValue> ;
	<https://www.reqvire.org/ontology#governanceValueName> "critical" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Requirement realization has severe uncertainty or exposure where failure, change, or non-compliance may materially affect mission, safety, compliance, cost, or schedule." ;
	<https://www.reqvire.org/ontology#governanceDefaultValue> false .
<https://www.reqvire.org/ontology#governanceAuthoringRule> a <https://www.reqvire.org/ontology#GovernanceRule> ;
	<https://www.reqvire.org/ontology#governanceRuleName> "governance-authoring" ;
	<https://www.reqvire.org/ontology#governanceAppliesTo> "capability, requirement" ;
	<https://www.reqvire.org/ontology#ruleCondition> "An element declares status, priority, risk, or owner metadata." ;
	<https://www.reqvire.org/ontology#ruleOutcome> "Only capability and requirement elements may author governance metadata; contracts and verifications obtain context from their owner or linked requirement." .
<https://www.reqvire.org/ontology#governanceEffectiveValueRule> a <https://www.reqvire.org/ontology#GovernanceRule> ;
	<https://www.reqvire.org/ontology#governanceRuleName> "governance-effective-value" ;
	<https://www.reqvire.org/ontology#governanceAppliesTo> "capability, requirement, contract, verification" ;
	<https://www.reqvire.org/ontology#governanceSourceOrder> "explicit, inherited, default" ;
	<https://www.reqvire.org/ontology#ruleCondition> "A consumer requests effective governance metadata." ;
	<https://www.reqvire.org/ontology#ruleOutcome> "Return value and source for status, priority, risk, and owner; inherited values include source_identifier; defaults omit source_identifier." .
<https://www.reqvire.org/ontology#governancePersistenceRule> a <https://www.reqvire.org/ontology#GovernanceRule> ;
	<https://www.reqvire.org/ontology#governanceRuleName> "governance-persistence" ;
	<https://www.reqvire.org/ontology#governancePersistence> "explicit-only" ;
	<https://www.reqvire.org/ontology#ruleCondition> "Formatting or mutation rewrites a model file." ;
	<https://www.reqvire.org/ontology#ruleOutcome> "Persist only explicit governance metadata authored or changed by the user; never materialize inherited or default governance metadata into Markdown." .

