<https://www.reqvire.org/ontology#ConcreteVerification> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Concrete verification" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#Verification> ;
	<http://www.w3.org/2002/07/owl#disjointWith> <https://www.reqvire.org/ontology#VerificationObjective> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Executable or reviewable verification element that derives from a verification objective and verifies requirements." .
<https://www.reqvire.org/ontology#EvidenceBackedVerification> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Evidence-backed verification" ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#ConcreteVerification> .
