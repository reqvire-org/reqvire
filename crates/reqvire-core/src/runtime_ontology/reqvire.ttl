	<http://www.w3.org/2000/01/rdf-schema#domain> <https://www.reqvire.org/ontology#VerificationRollupRule> ;
	<http://www.w3.org/2000/01/rdf-schema#range> <http://www.w3.org/2001/XMLSchema#boolean> ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Whether the rollup rule applies to evidence-backed verification types." .
<https://www.reqvire.org/ontology#leafRequirementVerificationRule> a <https://www.reqvire.org/ontology#VerificationRollupRule> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Leaf requirement verification" ;
	<https://www.reqvire.org/ontology#rollupRuleName> "leaf-requirement-verification" ;
	<https://www.reqvire.org/ontology#rollupCondition> "A requirement has no child requirements through derive." ;
	<https://www.reqvire.org/ontology#rollupOutcome> "The requirement is verified when it has at least one direct verifiedBy relation to a verification element." .
<https://www.reqvire.org/ontology#parentRequirementRollupRule> a <https://www.reqvire.org/ontology#VerificationRollupRule> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Parent requirement rollup" ;
	<https://www.reqvire.org/ontology#rollupRuleName> "parent-requirement-rollup" ;
	<https://www.reqvire.org/ontology#rollupCondition> "A requirement has one or more child requirements through derive." ;
	<https://www.reqvire.org/ontology#rollupOutcome> "The requirement is verified only when all child requirements are verified; direct parent verification does not override an unverified child." .
<https://www.reqvire.org/ontology#capabilityCoverageRollupRule> a <https://www.reqvire.org/ontology#VerificationRollupRule> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Capability coverage rollup" ;
	<https://www.reqvire.org/ontology#rollupRuleName> "capability-coverage-rollup" ;
	<https://www.reqvire.org/ontology#rollupCondition> "A capability has requirements through specifiedBy or descendant capabilities through derive." ;
	<https://www.reqvire.org/ontology#rollupOutcome> "The capability coverage state is derived from requirements that specify the capability, child requirements, and child capability coverage." .
<https://www.reqvire.org/ontology#evidenceBackedVerificationRule> a <https://www.reqvire.org/ontology#VerificationRollupRule> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Evidence-backed verification satisfaction" ;
	<https://www.reqvire.org/ontology#rollupRuleName> "evidence-backed-verification-satisfaction" ;
	<https://www.reqvire.org/ontology#rollupCondition> "A verification element is test-verification or formal-proof-verification." ;
	<https://www.reqvire.org/ontology#rollupOutcome> "The verification is satisfied only when it has at least one satisfiedBy evidence artifact." ;
	<https://www.reqvire.org/ontology#evidenceBacked> true .
<https://www.reqvire.org/ontology#nonEvidenceBackedVerificationRule> a <https://www.reqvire.org/ontology#VerificationRollupRule> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Non-evidence-backed verification satisfaction" ;
	<https://www.reqvire.org/ontology#rollupRuleName> "non-evidence-backed-verification-satisfaction" ;
	<https://www.reqvire.org/ontology#rollupCondition> "A verification element is analysis-verification, inspection-verification, or demonstration-verification." ;
	<https://www.reqvire.org/ontology#rollupOutcome> "The verification does not require satisfiedBy evidence for coverage satisfaction." ;
	<https://www.reqvire.org/ontology#evidenceBacked> false .

