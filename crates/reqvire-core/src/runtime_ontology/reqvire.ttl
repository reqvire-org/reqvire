<https://www.reqvire.org/ontology#RelationRule> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Relation rule" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Controlled rule for an authored Reqvire relation name, allowed endpoint types, direction, ownership, and impact behavior." .
<https://www.reqvire.org/ontology#RelationConstraint> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Relation constraint" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Constraint concept that further qualifies a relation rule." .
<https://www.reqvire.org/ontology#TraversalRule> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Traversal rule" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Rule describing how a relation category may be traversed for model navigation." .
<https://www.reqvire.org/ontology#ReusedContractContextCompatibilityRule> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationConstraint> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Reused Contract Context compatibility rule" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Constraint defining valid reused_contract_context source, target, and owner compatibility." .
<https://www.reqvire.org/ontology#RelationUsageCategory> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Relation usage category" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Controlled category grouping relation names by operational usage such as model traversal, change propagation, or rollup." .
<https://www.reqvire.org/ontology#RelationSemanticCategory> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Relation semantic category" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Controlled category grouping relation names by their model semantics." .
<https://www.reqvire.org/ontology#RelationSemanticPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Relation semantic pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Controlled semantic pattern that describes whether a relation family is hierarchy, bridge, ownership, constraint, dependency, verification, satisfaction, or cross-subgraph contract dependency." .
<https://www.reqvire.org/ontology#RelationFamily> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Relation family" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Controlled family that groups authored relation names and inverse pairs by stable model meaning and exposes normalized query predicates for semantic traversal." .
<https://www.reqvire.org/ontology#RelationPredicateLayer> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Relation predicate layer" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Controlled layer classifying a relation predicate as source-authored vocabulary or normalized semantic query vocabulary." .
<https://www.reqvire.org/ontology#ModelRelation> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Model relation" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "First-class projection record for one authored Reqvire relation edge, used by construct-query specifications to preserve source, target, and relation-token pairing." .
<https://www.reqvire.org/ontology#HierarchyRelationPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Hierarchy relation pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern for same-family parent-child hierarchy with optional ancestor-descendant closure." .
<https://www.reqvire.org/ontology#BridgeRelationPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Bridge relation pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern connecting model families without transitive hierarchy semantics." .
<https://www.reqvire.org/ontology#OwnershipRelationPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Ownership relation pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern where one element owns another element as local defining context." .
<https://www.reqvire.org/ontology#ConstraintRelationPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Constraint relation pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern applying semantic-contract constraints to governed requirements." .
<https://www.reqvire.org/ontology#DependencyRelationPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Dependency relation pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern where one element depends on another context element without ownership." .
<https://www.reqvire.org/ontology#VerificationRelationPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Verification relation pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern connecting requirements to verification elements." .
<https://www.reqvire.org/ontology#SatisfactionRelationPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Satisfaction relation pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern connecting requirements or evidence-backed verifications to implementation or evidence artifacts." .
<https://www.reqvire.org/ontology#CrossSubgraphContractDependencyPattern> a <http://www.w3.org/2002/07/owl#Class> ;
	<http://www.w3.org/2000/01/rdf-schema#subClassOf> <https://www.reqvire.org/ontology#RelationSemanticPattern> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Cross-subgraph contract dependency pattern" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Relation pattern for a requirement using reusable requirement-owned contract context from another subgraph without transferring ownership." .
<https://www.reqvire.org/ontology#authoredRelationLayer> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationPredicateLayer> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Authored relation layer" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Layer for relation predicates that preserve authored Markdown relation names and source-model fidelity." .
<https://www.reqvire.org/ontology#normalizedRelationLayer> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationPredicateLayer> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Normalized relation layer" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Layer for generated relation-family predicates used by semantic traversal, graph projection, reports, rollups, and query APIs." .
<https://www.reqvire.org/ontology#hierarchyRelationPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#HierarchyRelationPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "hierarchy" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Same-family parent-child hierarchy. Only this pattern has ancestor-descendant closure semantics." .
<https://www.reqvire.org/ontology#bridgeRelationPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#BridgeRelationPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "bridge" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Direct bridge between different model families without hierarchy closure." .
<https://www.reqvire.org/ontology#ownershipRelationPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#OwnershipRelationPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "ownership" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Direct ownership of local defining context." .
<https://www.reqvire.org/ontology#constraintRelationPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#ConstraintRelationPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "constraint" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Direct application of semantic-contract constraints." .
<https://www.reqvire.org/ontology#dependencyRelationPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#DependencyRelationPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "dependency" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Direct semantic dependency without ownership." .
<https://www.reqvire.org/ontology#verificationRelationPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#VerificationRelationPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "verification" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Direct verification relationship." .
<https://www.reqvire.org/ontology#satisfactionRelationPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#SatisfactionRelationPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "satisfaction" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Direct implementation or evidence satisfaction relationship." .
<https://www.reqvire.org/ontology#crossSubgraphContractDependencyPattern> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationSemanticPattern> , <https://www.reqvire.org/ontology#CrossSubgraphContractDependencyPattern> ;
	<https://www.reqvire.org/ontology#semanticPatternName> "cross-subgraph-contract-dependency" ;
	<http://www.w3.org/2000/01/rdf-schema#comment> "Direct cross-subgraph dependency from a requirement to reusable requirement-owned contract context declared through the reused_contract_context authoring mechanism." .
<https://www.reqvire.org/ontology#hierarchyRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Hierarchy relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "hierarchy" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Same-family parent-child derivation with ancestor-descendant closure semantics." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#childElement> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#parentElement> .
<https://www.reqvire.org/ontology#capabilitySpecificationRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Capability specification relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "capability-specification" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Bridge between a capability and the requirements that specify it." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#capabilitySpecifiedByRequirement> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#requirementSpecifiesCapability> .
<https://www.reqvire.org/ontology#contractOwnershipRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Contract ownership relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "contract-ownership" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Definition relationship between a requirement and the local non-semantic contract context that defines it." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#requirementDefinedByContract> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#contractDefinesRequirement> .
<https://www.reqvire.org/ontology#semanticContractConstraintRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Semantic contract constraint relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "semantic-contract-constraint" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Application of semantic-contract SHACL constraints to governed requirements." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#requirementConstrainedBySemanticContract> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#semanticContractConstrainsRequirement> .
<https://www.reqvire.org/ontology#semanticContractOntologyUseRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Semantic contract ontology use relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "semantic-contract-ontology-use" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Dependency from a semantic contract to ontology vocabulary used by its SHACL shapes." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#semanticContractUsesOntology> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#ontologyUsedBySemanticContract> .
<https://www.reqvire.org/ontology#verificationRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Verification relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "verification" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Verification relationship between requirements and concrete verification elements." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#requirementVerifiedByVerification> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#verificationVerifiesRequirement> .
<https://www.reqvire.org/ontology#satisfactionRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Satisfaction relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "satisfaction" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Implementation or evidence satisfaction relationship from requirements or evidence-backed verifications to artifacts." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#elementSatisfiedByArtifact> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#artifactSatisfiesElement> .
<https://www.reqvire.org/ontology#crossSubgraphContractDependencyRelationFamily> a <http://www.w3.org/2002/07/owl#NamedIndividual> , <https://www.reqvire.org/ontology#RelationFamily> ;
	<http://www.w3.org/2000/01/rdf-schema#label> "Cross-subgraph contract dependency relation family" ;
	<https://www.reqvire.org/ontology#relationFamilyName> "cross-subgraph-contract-dependency" ;
	<https://www.reqvire.org/ontology#relationFamilyMeaning> "Dependency from a requirement to reusable requirement-owned contract context in another subgraph." ;
	<https://www.reqvire.org/ontology#relationFamilyForwardProperty> <https://www.reqvire.org/ontology#requirementUsesCrossSubgraphContract> ;
	<https://www.reqvire.org/ontology#relationFamilyInverseProperty> <https://www.reqvire.org/ontology#crossSubgraphContractUsedByRequirement> .
