	<https://www.reqvire.org/ontology#validationRuleName> "single-root-hierarchy-ownership" ;
	<https://www.reqvire.org/ontology#validationScope> "capability-requirement-graph" ;
	<https://www.reqvire.org/ontology#validationSeverity> "error" ;
	<https://www.reqvire.org/ontology#validationCondition> "A requirement hierarchy resolves to zero or more than one owning capability root." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Validation fails because each requirement hierarchy must belong to exactly one capability root." ;
	<https://www.reqvire.org/ontology#validationRepair> "Add or repair specify/derivedFrom relations so the hierarchy resolves to one capability root." .
<https://www.reqvire.org/ontology#relationTypeCompatibilityRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "relation-type-compatibility" ;
	<https://www.reqvire.org/ontology#validationScope> "relations" ;
	<https://www.reqvire.org/ontology#validationSeverity> "error" ;
	<https://www.reqvire.org/ontology#validationCondition> "A relation source, relation type, or target violates relation compatibility rules." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Validation fails before the graph is used." ;
	<https://www.reqvire.org/ontology#validationRepair> "Use a compatible relation type or change element types/ownership." .
<https://www.reqvire.org/ontology#reusedContractContextHierarchyIndependenceRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "reused-contract-context-hierarchy-independence" ;
	<https://www.reqvire.org/ontology#validationScope> "reused_contract_context" ;
	<https://www.reqvire.org/ontology#validationSeverity> "error" ;
	<https://www.reqvire.org/ontology#validationCondition> "An element reuses a contract already available through owner hierarchy or ancestor reused_contract_context propagation." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Validation fails because the reused_contract_context is redundant or hides the intended dependency boundary." ;
	<https://www.reqvire.org/ontology#validationRepair> "Remove the redundant reused_contract_context or reuse the contract at the highest valid boundary." .
<https://www.reqvire.org/ontology#reusedContractContextSubgraphDirectionRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "reused-contract-context-subgraph-direction" ;
	<https://www.reqvire.org/ontology#validationScope> "capability-root-subgraphs" ;
	<https://www.reqvire.org/ontology#validationSeverity> "error" ;
	<https://www.reqvire.org/ontology#validationCondition> "Two requirement subgraphs reuse contracts to each other in both directions." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Validation fails because cross-subgraph reused_contract_context contracts must be one-directional." ;
	<https://www.reqvire.org/ontology#validationRepair> "Keep one dependency direction and move shared contracts into a common reused source if needed." .
<https://www.reqvire.org/ontology#crossSectionDuplicateRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "cross-section-duplicate" ;
	<https://www.reqvire.org/ontology#validationScope> "element-subsections" ;
	<https://www.reqvire.org/ontology#validationSeverity> "error" ;
	<https://www.reqvire.org/ontology#validationCondition> "The same target appears in both Relations and Reused Contract Context for one element." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Validation fails because the model cannot infer which semantic channel is intended." ;
	<https://www.reqvire.org/ontology#validationRepair> "Remove either the relation entry or the reused_contract_context entry." .
<https://www.reqvire.org/ontology#semanticReferenceReachabilityValidationRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "semantic-reference-reachability-validation" ;
	<https://www.reqvire.org/ontology#validationScope> "semantic-contract-use-ontology-context" ;
	<https://www.reqvire.org/ontology#validationSeverity> "error" ;
	<https://www.reqvire.org/ontology#validationCondition> "A SHACL reference points to an ontology term that is not declared or is declared outside the semantic contract's explicit use graph." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Validation fails because semantic dependencies must remain visible to change impact." ;
	<https://www.reqvire.org/ontology#validationRepair> "Declare the term in ontology used by the semantic contract, add a use relation to the declaring ontology or an ontology descendant whose hierarchy reaches it, or remove/update the reference." .
<https://www.reqvire.org/ontology#lintManualReviewRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "lint-manual-review" ;
	<https://www.reqvire.org/ontology#validationScope> "lint" ;
	<https://www.reqvire.org/ontology#validationSeverity> "warning" ;
	<https://www.reqvire.org/ontology#validationCondition> "A model quality issue is auditable but not safely auto-fixable." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Report as manual review issue and do not auto-modify the model." ;
	<https://www.reqvire.org/ontology#validationRepair> "User reviews context and applies an explicit model change." .
<https://www.reqvire.org/ontology#crossSubmodelHierarchicalLintRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "lint-cross-submodel-hierarchical-relation" ;
	<https://www.reqvire.org/ontology#validationScope> "lint" ;
	<https://www.reqvire.org/ontology#validationSeverity> "warning" ;
	<https://www.reqvire.org/ontology#validationCondition> "A user-authored hierarchical relation crosses capability-root submodel ownership boundaries." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Report as manual review because ownership boundary intent is ambiguous." ;
	<https://www.reqvire.org/ontology#validationRepair> "Replace with reused_contract_context/trace or remodel hierarchy under one capability root." .
<https://www.reqvire.org/ontology#redundantHierarchicalLintRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "lint-redundant-hierarchical-relation" ;
	<https://www.reqvire.org/ontology#validationScope> "lint" ;
	<https://www.reqvire.org/ontology#validationSeverity> "warning" ;
	<https://www.reqvire.org/ontology#validationCondition> "An element has direct hierarchical relations to both an ancestor and descendant path already reachable through hierarchy." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Report as auto-fixable when the redundant relation can be removed without changing reachability." ;
	<https://www.reqvire.org/ontology#validationRepair> "Remove the redundant direct derivedFrom/derive relation." .
<https://www.reqvire.org/ontology#redundantVerifyLintRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "lint-redundant-verify-relation" ;
	<https://www.reqvire.org/ontology#validationScope> "lint" ;
	<https://www.reqvire.org/ontology#validationSeverity> "warning" ;
	<https://www.reqvire.org/ontology#validationCondition> "A verification directly verifies both a requirement and an ancestor covered by that requirement's verification path." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Report as manual review or auto-fixable depending on whether removing the ancestor verify relation preserves intended evidence scope." ;
	<https://www.reqvire.org/ontology#validationRepair> "Keep verification at the most precise requirement scope, or document why broader requirement verification is intended." .
<https://www.reqvire.org/ontology#multiBranchConvergenceLintRule> a <https://www.reqvire.org/ontology#ValidationRule> ;
	<https://www.reqvire.org/ontology#validationRuleName> "lint-multi-branch-convergence" ;
	<https://www.reqvire.org/ontology#validationScope> "lint" ;
	<https://www.reqvire.org/ontology#validationSeverity> "warning" ;
	<https://www.reqvire.org/ontology#validationCondition> "An element reaches a common ancestor through multiple distinct branch paths." ;
	<https://www.reqvire.org/ontology#validationOutcome> "Report as manual review because both paths may be meaningful or one may be a modeling error." ;
	<https://www.reqvire.org/ontology#validationRepair> "Retain both paths only when they represent distinct valid semantics." .

