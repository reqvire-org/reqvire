@prefix ext: <https://example.test/external#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.test/external> a owl:Ontology ;
  rdfs:label "External test vocabulary" .

ext:ExternalResource a owl:Class ;
  rdfs:label "External resource" .

ext:ExternalCode a rdfs:Datatype ;
  rdfs:label "External code datatype" .

ext:externalCode a owl:DatatypeProperty ;
  rdfs:domain ext:ExternalResource ;
  rdfs:range ext:ExternalCode .
