    },
    {
      "@id": "jsonext:JsonExternalResource",
      "@type": "owl:Class",
      "rdfs:label": "JSON-LD external resource"
    },
    {
      "@id": "jsonext:jsonExternalCode",
      "@type": "owl:DatatypeProperty",
      "rdfs:label": "JSON-LD external code property"
    }
  ]
