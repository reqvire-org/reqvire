@prefix ext: <https://example.test/shacl-external#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.test/shacl-external> a owl:Ontology ;
  rdfs:label "Reachable SHACL external vocabulary" .

ext:ExternalEvent a owl:Class ;
  rdfs:label "External event" .

ext:ExternalCode a rdfs:Datatype ;
  rdfs:label "External code datatype" .

ext:externalNode a owl:Class ;
  rdfs:label "External value node" .

ext:externalLink a owl:ObjectProperty ;
  rdfs:domain ext:ExternalEvent ;
  rdfs:range ext:externalNode .

ext:externalCode a owl:DatatypeProperty ;
  rdfs:domain ext:ExternalEvent ;
  rdfs:range ext:ExternalCode .
