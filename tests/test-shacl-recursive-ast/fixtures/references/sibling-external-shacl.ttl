@prefix sib: <https://example.test/sibling-external#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.test/sibling-external> a owl:Ontology ;
  rdfs:label "Sibling SHACL external vocabulary" .

sib:SiblingNode a owl:Class ;
  rdfs:label "Sibling external value node" .
