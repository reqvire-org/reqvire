{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "ads": {
      "type": "stdio",
      "command": "node",
      "args": [
        "explorer/node_modules/@reqvire-org/ads/dist/cli.mjs",
        "mcp",
        "explorer",
        "--mutations"
      ]
    }
  }
}
