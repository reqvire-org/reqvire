{
  "mcpServers": {
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest"
      ],
      "env": {}
    },
    "reqvire": {
      "type": "stdio",
      "command": "./target/debug/reqvire",
      "args": [
        "--workspace",
        ".",
        "mcp",
        "--transport",
        "stdio",
        "--enable-mutations"
      ]
    },
    "ads": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@reqvire-org/ads@0.3.20",
        "mcp",
        "explorer",
        "--mutations"
      ]
    }
  }
}
